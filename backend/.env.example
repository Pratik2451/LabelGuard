# ============================================================
# LabelGuard Backend Environment Configuration Example
# ============================================================
# Copy this file to .env and set your actual credentials.
# In Render: configure these under 'Environment Variables'.

# Port the server listens on (Render automatically provides PORT=10000)
PORT=8000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional Database Name (defaults to 'LabelGuard' if left blank)
DB_NAME=LabelGuard

# Security: JWT Token Secrets (Use long random strings, min 32 characters)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# CORS Allowed Origin (The URL of your deployed Vercel frontend)
# Example: https://labelguard.vercel.app (or * for public prototype)
CORS_ORIGIN=https://your-frontend-app.vercel.app

# Python OCR Execution
# Device for PaddleOCR: 'cpu' (recommended for Render) or 'gpu:0'
PADDLE_DEVICE=cpu

# Optional: Path to custom Python executable if not in system PATH
# PYTHON_PATH=python3

