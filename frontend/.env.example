# ============================================================
# LabelGuard Frontend Environment Configuration Example
# ============================================================
# Set this in your Vercel Project Settings under 'Environment Variables'.
#
# In local development: leave blank or commented out (Vite will proxy /api to localhost:5000)
# In Vercel production: set to the public URL of your deployed Render backend service.
#
# Example:
# VITE_API_URL=https://labelguard-api.onrender.com

VITE_API_URL=

